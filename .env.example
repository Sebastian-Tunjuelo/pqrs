POSTGRES_DB=pqrs
POSTGRES_USER=pqrs
POSTGRES_PASSWORD=pqrs
# Puerto en el host (el contenedor sigue escuchando en 5432). Por defecto 5433 por conflicto con Postgres local en Windows.
POSTGRES_PORT=5433

# API Rust (sqlx / Axum)
DATABASE_URL=postgresql://pqrs:pqrs@localhost:5433/pqrs?sslmode=disable
PORT=8080

# Next.js (presentation) → API Rust
NEXT_PUBLIC_API_URL=http://localhost:8080
# Nombre mostrado en cabecera (demo)
NEXT_PUBLIC_DEMO_OFFICER_NAME=María López — Asesoría jurídica

# API Rust → Redis (síntesis bajo demanda; mismo Redis que el worker Python)
# REDIS_URL=redis://127.0.0.1:6379/0

# Next.js **servidor** (ruta /api/assist/ollama): leer PQRS desde la API Rust. Si omites, usa NEXT_PUBLIC_API_URL.
# API_URL=http://127.0.0.1:8080
# Ollama desde el servidor Next (mismo host que el navegador en local):
# OLLAMA_URL=http://127.0.0.1:11434

# E2E (pytest e2e/tests): URL de la API Rust
# E2E_API_URL=http://127.0.0.1:8080

REDIS_PORT=6379

OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2:3b
# API Rust → Ollama (asistente / explicar rechazo)
OLLAMA_URL=http://127.0.0.1:11434

# Warehouse (DuckDB + Alembic)
# DATABASE_URL=postgresql+psycopg://pqrs:pqrs@localhost:5432/pqrs
WAREHOUSE_DUCKDB_PATH=./data/pqrs_warehouse.duckdb
POSTGRES_HOST=localhost
